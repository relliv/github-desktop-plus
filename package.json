{
  "name": "electron-vue-vite-tw",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "Really simple Electron + Vue + Vite boilerplate.",
  "author": "relliv",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,jsx,json,css,scss,md,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,jsx,json,css,scss,md,html,yml,yaml}\"",
    "prepare": "husky",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,jsx,json,css,scss,md,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.5"
  },
  "dependencies": {
    "@ngeenx/nx-code-viewer-theme": "file:../../nn/nx-code-viewer/packages/styles/nx-code-viewer-theme",
    "@ngeenx/nx-code-viewer-utils": "file:../../nn/nx-code-viewer/dist/packages/client/nx-code-viewer-utils",
    "@ngeenx/nx-vue-code-viewer": "file:../../nn/nx-code-viewer/dist/packages/client/ui/nx-vue-code-viewer",
    "@number-flow/vue": "^0.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "lenis": "^1.3.25",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "shiki": "^4.3.0",
    "simple-git": "^3.36.0",
    "simple-icons": "^16.24.0",
    "tailwind-merge": "^3.6.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.1.0",
    "vue-virtual-scroller": "3.0.4"
  }
}
